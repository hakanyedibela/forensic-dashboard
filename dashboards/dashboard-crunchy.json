      "title": "Replication Lag",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (ccp_replication_lag_replay_time{pg_cluster=\"$cluster\"})",
          "refId": "A",
          "legendFormat": "Replay Lag {{pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (ccp_replication_lag_received_time{pg_cluster=\"$cluster\"})",
          "refId": "B",
          "legendFormat": "Receive Lag {{pod}}"
        }
      ],
      "description": "Per replica: time since the last replayed transaction (Replay) and the last received WAL (Receive). Both also grow while the primary has no writes, so check together with WAL Activity."
    },
