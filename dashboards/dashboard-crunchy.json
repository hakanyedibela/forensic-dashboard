          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Transactions/s",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ccp_stat_database_xact_commit{pg_cluster=\"$cluster\"}[5m]))",
          "refId": "A",
          "legendFormat": "Commits/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ccp_stat_database_xact_rollback{pg_cluster=\"$cluster\"}[5m]))",
          "refId": "B",
          "legendFormat": "Rollbacks/s"
        }
      ],
      "description": "Commits and rollbacks per second over all databases and instances. A growing rollback share points to application errors."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
