      "title": "Block I/O",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ccp_stat_database_blks_read{pg_cluster=\"$cluster\"}[5m]))",
          "refId": "A",
          "legendFormat": "Blocks Read/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ccp_stat_database_blks_hit{pg_cluster=\"$cluster\"}[5m]))",
          "refId": "B",
          "legendFormat": "Blocks Hit/s (cache)"
        }
      ],
      "description": "Blocks read from disk vs. found in shared_buffers per second. Sustained high disk reads = working set larger than memory."
    },
