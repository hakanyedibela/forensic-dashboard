      "title": "WAL Activity",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ccp_wal_activity_last_5_min_size_bytes{pg_cluster=\"$cluster\", role=\"master\"}) / 300",
          "refId": "A",
          "legendFormat": "WAL Bytes/s (5m avg)"
        }
      ],
      "description": "WAL written by the primary, averaged over the last 5 minutes (bytes/s). Drives archive volume and replication traffic."
