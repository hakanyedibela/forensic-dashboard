      "title": "WAL Size",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ccp_wal_activity_total_size_bytes{pg_cluster=\"$cluster\", role=\"master\"})",
          "refId": "A"
        }
      ],
      "description": "Current size of the pg_wal directory on the primary. A steady rise usually means archiving is failing or a replication slot holds WAL back."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 8,
