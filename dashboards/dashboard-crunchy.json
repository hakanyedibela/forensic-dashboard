        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Connections",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ccp_connection_stats_total{pg_cluster=\"$cluster\"})",
          "refId": "A",
          "legendFormat": "Total"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ccp_connection_stats_idle_in_txn{pg_cluster=\"$cluster\"})",
          "refId": "B",
          "legendFormat": "Idle in TX"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(ccp_connection_stats_max_query_time{pg_cluster=\"$cluster\"})",
          "refId": "C",
          "legendFormat": "Max Query Time (s)"
        }
      ],
      "description": "Total connections, connections idle in transaction (they hold locks and block vacuum), and the longest running query in seconds. Note: the query time shares the axis with the counts."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
