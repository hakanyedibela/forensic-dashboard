      "title": "Database Size",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ccp_database_size_bytes{pg_cluster=\"$cluster\", role=\"master\"})",
          "refId": "A"
        }
      ],
      "description": "Size of all databases on the primary (role=master)."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
