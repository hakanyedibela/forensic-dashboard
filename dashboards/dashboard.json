        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 13, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
