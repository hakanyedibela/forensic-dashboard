      "description": "Informational alerts (e.g. PostgreSQL restarted). No action required. Source: Prometheus ALERTS series (rules deployed as PrometheusRule). Rules imported into Grafana appear only in the Alert inbox.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\", severity=\"info\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
