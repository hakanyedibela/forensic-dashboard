{
  "uid": "edb-alert-center",
  "title": "EDB PostgreSQL — Alert Center",
  "tags": [
    "edb",
    "postgres",
    "alerts"
  ],
  "editable": true,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Cluster Overview",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "url": "/d/edb-pg-overview?${__url_time_range}&var-datasource=${datasource}&var-namespace=${namespace}&var-cluster=${cluster}",
      "keepTime": true,
      "includeVars": false,
      "tooltip": "Health, performance and replication of the same cluster."
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "options": [],
        "refresh": 1,
        "description": "Prometheus (or Thanos Querier) datasource holding the ALERTS series."
      },
      {
        "name": "scope",
        "label": "Scope",
        "type": "custom",
        "hide": 0,
        "query": "EDB Postgres : edb-postgres,All alerts : .*",
        "options": [
          {
            "text": "EDB Postgres",
            "value": "edb-postgres",
            "selected": true
          },
          {
            "text": "All alerts",
            "value": ".*",
            "selected": false
          }
        ],
        "current": {
          "text": "EDB Postgres",
          "value": "edb-postgres"
        },
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "description": "EDB Postgres = only rules labelled component=edb-postgres. All alerts = every Prometheus alert (Kubernetes, nodes, ...)."
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(ALERTS_FOR_STATE, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(ALERTS_FOR_STATE, namespace)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {},
        "options": [],
        "description": "Namespaces that had alerts in the selected time range. All = every namespace."
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "custom",
        "hide": 0,
        "query": "critical : critical,warning : warning,info : info",
        "options": [
          {
            "text": "critical",
            "value": "critical",
            "selected": true
          },
          {
            "text": "warning",
            "value": "warning",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          }
        ],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "description": "Filter by alert severity. critical = act now, warning = investigate soon, info = no action."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Critical",
      "description": "Firing alerts with severity=critical in the current scope. Needs action now. Source: Prometheus ALERTS series (rules deployed as PrometheusRule). Rules imported into Grafana appear only in the Alert inbox.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\", severity=\"critical\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Warning",
      "description": "Firing alerts with severity=warning. Investigate soon. Source: Prometheus ALERTS series (rules deployed as PrometheusRule). Rules imported into Grafana appear only in the Alert inbox.",
      "targets": [
