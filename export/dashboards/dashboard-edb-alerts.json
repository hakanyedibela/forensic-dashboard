      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"pending\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Affected namespaces",
      "description": "Namespaces with at least one firing alert. Source: Prometheus ALERTS series (rules deployed as PrometheusRule). Rules imported into Grafana appear only in the Alert inbox.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(count by (namespace) (ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Oldest active alert",
      "description": "How long the longest-running alert has been active.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "time() - min(ALERTS_FOR_STATE{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          },
          "mappings": [],
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "alertlist",
      "title": "Alert inbox (expand an alert for summary / description)",
      "description": "Every firing/pending alert, whether Prometheus evaluates the rule (PrometheusRule) or Grafana does (rules imported into Grafana). 'View alert rule' opens the rule with its query and history.",
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 100,
        "sortOrder": 3,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"}",
        "datasource": null,
        "folder": null,
        "showInstances": true,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "recovering": true,
          "noData": false,
          "normal": false,
          "error": true
        }
      },
      "id": 8,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "Active alerts",
      "description": "One row per active alert instance. 'active since' comes from ALERTS_FOR_STATE.\n\n- **severity**: critical = act now, warning = investigate soon, info = no action needed.\n- **alertname**: Name of the Prometheus rule (manifests/edb-postgres-alerts.yaml).\n- **pod**: Instance the alert refers to. Empty for cluster-wide alerts (backups, primary election).\n- **alertstate**: FIRING = condition held for the rule's 'for' duration. pending = condition true, 'for' not yet reached.\n- **namespace**: Kubernetes namespace of the affected workload.\n- **active since**: When the condition first became true (ALERTS_FOR_STATE), including the pending phase.\n- **duration**: Time since 'active since'.\n- **what it means / what to do**: Description of the rule; <label> placeholders refer to the columns on the left.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "(ALERTS_FOR_STATE{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"} + ignoring (alertstate) group_right () (ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"} * 0)) * 1000",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "time() - (ALERTS_FOR_STATE{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"} + ignoring (alertstate) group_right () (ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"} * 0))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "label_replace((ALERTS_FOR_STATE{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"} + ignoring (alertstate) group_right () (ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\"} * 0)), \"action\", \"$1\", \"alertname\", \"(.*)\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "severity",
                "alertstate",
                "alertname",
                "namespace",
                "pod",
                "Value #A",
                "Value #B",
                "action"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "component": true,
              "job": true,
              "namespace": false,
              "instance": true,
              "endpoint": true,
              "container": true,
              "service": true,
              "prometheus": true,
              "alertstate": false,
              "cluster": true,
              "stats_reset": true,
              "value": true,
              "Value #C": true
            },
            "renameByName": {
              "Value #A": "active since",
              "Value #B": "duration",
              "action": "what it means / what to do"
            },
            "indexByName": {
              "severity": 0,
              "alertstate": 1,
              "alertname": 2,
              "namespace": 3,
              "pod": 4,
              "Value #A": 5,
              "Value #B": 6,
              "action": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "critical",
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "text": "warning",
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "text": "info",
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alertstate"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "FIRING",
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "text": "pending",
                        "color": "yellow",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alertname"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "namespace"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pod"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "active since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "what it means / what to do"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CNPInstanceDown": {
                        "text": "The instance manager cannot reach PostgreSQL on <pod> (cluster <cluster>).",
                        "color": "text",
                        "index": 0
                      },
                      "CNPMetricsTargetDown": {
                        "text": "Prometheus cannot scrape port 9187 of <pod>. Pod down, TLS mismatch on the PodMonitor, or NetworkPolicy.",
                        "color": "text",
                        "index": 1
                      },
                      "CNPNoPrimary": {
                        "text": "All instances are in recovery and the cluster is not in replica mode. Writes are failing.",
                        "color": "text",
                        "index": 2
                      },
                      "CNPMultiplePrimaries": {
                        "text": "More than one instance is out of recovery (split brain). Check `kubectl cnp status`.",
                        "color": "text",
                        "index": 3
                      },
                      "CNPFencingActive": {
                        "text": "Fencing is on; PostgreSQL on this instance is stopped. Remove the k8s.enterprisedb.io/fencedInstances annotation when done.",
                        "color": "text",
                        "index": 4
                      },
                      "CNPManualSwitchoverRequired": {
                        "text": "The operator needs a manual switchover to proceed (e.g. primaryUpdateStrategy: supervised).",
                        "color": "text",
                        "index": 5
                      },
                      "CNPNoHighAvailability": {
                        "text": "A single node failure takes down the whole cluster. Check pod anti-affinity.",
                        "color": "text",
                        "index": 6
                      },
                      "CNPMetricsCollectionError": {
                        "text": "At least one monitoring query errors. Dashboards/alerts based on it are blind. Check instance logs for 'cnp_metrics_exporter'.",
                        "color": "text",
                        "index": 7
                      },
                      "CNPPostgresRestarted": {
                        "text": "Postmaster restarted inside the running pod in the last 15 minutes (crash recovery, config reload with restart, promotion).",
                        "color": "text",
                        "index": 8
                      },
                      "CNPReplicationLag": {
                        "text": "Standby is lagging behind the primary by more than 5 minutes.",
                        "color": "text",
                        "index": 9
                      },
                      "CNPReplicationLagCritical": {
