    {
      "type": "table",
      "title": "Alert log",
      "description": "Every alert instance that fired in the selected range (1-minute resolution). Range limited by Prometheus retention.\n\n- **severity**: critical = act now, warning = investigate soon, info = no action needed.\n- **alertname**: Name of the Prometheus rule (manifests/edb-postgres-alerts.yaml).\n- **pod**: Instance the alert refers to. Empty for cluster-wide alerts (backups, primary election).\n- **status**: FIRING = still firing at the end of the time range; resolved = not firing any more.\n- **namespace**: Kubernetes namespace of the affected workload.\n- **first seen**: First minute the alert was firing within the selected time range.\n- **last seen**: Last minute the alert was firing within the selected time range.\n- **minutes firing**: Minutes in firing state within the selected time range (1-minute resolution).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min_over_time(timestamp(ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"})[$__range:1m]) * 1000",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max_over_time(timestamp(ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"})[$__range:1m]) * 1000",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "count_over_time(ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"}[$__range:1m])",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "ALERTS{component=~\"$scope\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
